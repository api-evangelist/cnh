          "name": "Get vehicle telemetry (ISO 15143-3)",
          "request": {
            "name": "Get vehicle telemetry (ISO 15143-3)",
            "description": {
              "content": "Returns telemetry for a single vehicle following ISO 15143-3. Use the `profile` parameter to select CP (CAN Parameter, default) or MH (Machine Health) data. Supply `startDate` and `endDate` (recommended: one-day window) to constrain the response and improve performance.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "telemetry",
                ":vehicleId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "profile",
                  "value": "CP"
                },
                {
                  "disabled": false,
                  "key": "startDate",
                  "value": "<dateTime>"
                },
                {
                  "disabled": false,
                  "key": "endDate",
                  "value": "<dateTime>"
